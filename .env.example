# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
# These are public identifiers, not secrets; access is controlled by Firestore rules + sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Only for `npm run seed` (never commit real values):
#   GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
#   SEED_PASSWORD=choose-a-demo-password
